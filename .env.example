# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGODB_DATABASE=manualmind
MONGODB_COLLECTION=documents

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-3.5-flash

# Hybrid Search & Reranking Configuration
SEMANTIC_CANDIDATE_LIMIT=20
KEYWORD_CANDIDATE_LIMIT=20
RRF_K=60
RERANKING_ENABLED=true
RERANK_CANDIDATE_LIMIT=10
RETRIEVAL_TOP_K=5

# Maintenance Email & SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=maintenance@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=maintenance@manualmind.ai
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
